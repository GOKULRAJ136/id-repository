      "response": {
        "status": 302,
        "headers": {
          "Set-Cookie": "Authorization=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImxvY2FsZGV2In0..bG9jYWxkZXYtc2lnbmF0dXJlLW5vdC12ZXJpZmllZA; Path=/; Max-Age=31536000; SameSite=Lax",
          "Location": "http://localhost:8090/idrepository/v1/identity/swagger-ui/index.html",
          "Cache-Control": "no-store"
        }
      }
    }
  ]
}
