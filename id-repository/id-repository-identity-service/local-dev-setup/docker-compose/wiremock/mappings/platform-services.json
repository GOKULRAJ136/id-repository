{
  "mappings": [
    {
      "name": "Audit manager - accept audit events",
      "request": { "method": "POST", "url": "/v1/auditmanager/audits" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": null, "version": null, "response": { "status": true }, "errors": null }
      }
    },
    {
      "name": "ID generator - UIN (used by POST /draft/create without a UIN). Always the same valid UIN.",
      "request": { "method": "GET", "url": "/v1/idgenerator/uin" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": null, "version": null, "response": { "uin": "2838501739" }, "errors": null }
      }
    },
    {
      "name": "VID service - VIDs linked to a UIN (none locally)",
      "request": { "method": "GET", "urlPathPattern": "/idrepository/v1/vid/uin/[0-9]+" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": "mosip.vid.read", "version": "v1", "response": [], "errors": null }
      }
    },
    {
      "name": "VID service - resolve VID 2092493569127145 to UIN 7067209349 (samples/set-2). Wins over the catch-all below.",
      "priority": 1,
      "request": { "method": "GET", "urlPath": "/idrepository/v1/vid/2092493569127145" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": "mosip.vid.read", "version": "v1", "response": { "UIN": "7067209349" }, "errors": null }
      }
    },
    {
      "name": "VID service - resolve VID to UIN. Every other VID resolves to sample UIN 3649229809.",
      "priority": 5,
      "request": { "method": "GET", "urlPathPattern": "/idrepository/v1/vid/[0-9]+" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": "mosip.vid.read", "version": "v1", "response": { "UIN": "3649229809" }, "errors": null }
      }
    },
    {
      "name": "VID service - create draft VID (draft publish of a new identity)",
      "request": { "method": "POST", "url": "/idrepository/v1/draft/vid" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": "mosip.vid.create", "version": "v1", "response": { "VID": "5712817694382350", "vidStatus": "DRAFT" }, "errors": null }
      }
    },
    {
      "name": "VID service - update VID status (activate draft VID)",
      "request": { "method": "PATCH", "urlPathPattern": "/idrepository/v1/vid/[0-9]+" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": "mosip.vid.update", "version": "v1", "response": { "vidStatus": "ACTIVE" }, "errors": null }
      }
    },
    {
      "name": "PMS - online verification partners",
      "request": { "method": "GET", "urlPath": "/v1/partnermanager/partners" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": null, "version": null, "response": { "partners": [ { "partnerID": "mpartner-default-auth", "status": "Active" } ] }, "errors": null }
      }
    },
    {
      "name": "Credential request generator - issue credential",
      "request": { "method": "POST", "urlPathPattern": "/v1/credentialrequest/(v2/)?requestgenerator(/.*)?" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"id\":\"mosip.credential.request.service.id\",\"version\":\"1.0\",\"response\":{\"requestId\":\"{{randomValue type='UUID'}}\",\"id\":\"{{jsonPath request.body '$.request.id'}}\"},\"errors\":null}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "Credential request generator - cancel request",
      "request": { "method": "GET", "urlPathPattern": "/v1/credentialrequest/cancel/.+" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": null, "version": null, "response": { "status": "CANCELLED" }, "errors": null }
      }
    },
    {
      "name": "WebSub hub - register / publish / subscribe (202 Accepted)",
      "request": { "method": "POST", "urlPathPattern": "/hub/?" },
      "response": { "status": 202 }
    },
    {
      "name": "Download mock-sdk.zip (served to biosdk-service; generated by prepare-biosdk-mock-lib.sh/.bat)",
      "request": { "method": "GET", "url": "/downloads/mock-sdk.zip" },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/zip",
          "Content-Disposition": "attachment; filename=\"mock-sdk.zip\""
        },
        "bodyFileName": "mock-sdk.zip"
      }
    }
  ]
}
