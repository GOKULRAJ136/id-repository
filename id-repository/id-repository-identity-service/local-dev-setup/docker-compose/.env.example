# Copy to .env (same directory) and adjust. Docker Compose reads it automatically.

# Absolute path to your mosip-config clone (git clone -b release-1.3.1 https://github.com/mosip/mosip-config).
# The branch must match this service's version: release-1.3.x lacks keys the 1.3.1 code requires.
# Use forward slashes on Windows, e.g. C:/dev/mosip-config
MOSIP_CONFIG_DIR=/absolute/path/to/mosip-config
